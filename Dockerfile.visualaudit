# cc#2009: dedicated build for the visual-audit crawler (visual_audit.py, cc#2007). Used ONLY by
# the separate Railway service this card documents (see reports/CC2009_visual_audit_service.md for
# the exact console settings) -- does NOT touch nixpacks.toml or the web service's own build in any
# way. Root nixpacks.toml (Nixpacks, no Chromium) is what the web service keeps using; this image
# exists specifically because a headless-Chromium crawl needs a browser + its full native-library
# chain, which Nixpacks would need hand-assembled apt packages to reproduce -- Microsoft's own
# Playwright image already carries exactly the right ones for the exact Playwright version pinned
# in requirements below, which is the whole reason cc#2009's own spec asks for a Dockerfile here
# rather than extending nixpacks.toml.
FROM mcr.microsoft.com/playwright/python:v1.48.0-jammy

# cc#2015 item 1: build-log PROOF of what this image actually is, so the next base-image question is
# answered by the Build Logs instead of by three boot crashes. Every command is ||-guarded: this line
# can never fail the build, it only prints. Expected on this image: /ms-playwright present,
# python3 = /usr/bin/python3 (3.10), pip present, and PLAYWRIGHT_ABSENT_AT_BUILD -- see the note below.
RUN echo "== cc#2015 base-image diagnostic ==" && \
    (ls -d /ms-playwright && ls /ms-playwright || echo NO_MS_PLAYWRIGHT) && \
    (which python3 && python3 -V || echo NO_PYTHON3) && \
    (which pip && pip -V || echo NO_PIP) && \
    (python3 -c "import playwright, sys; print(playwright.__file__, sys.executable)" || echo PLAYWRIGHT_ABSENT_AT_BUILD) && \
    echo "== end diagnostic =="

WORKDIR /app

# The crawler reads pwa_endpoints.py's own NAV array as TEXT at runtime (visual_audit.py's
# parse_nav_routes -- item 3, never a hardcoded page list), so it needs the real repo checkout
# alongside it, not just visual_audit.py in isolation. Copies the whole build context Railway
# already clones for this service.
COPY . .

# cc#2015 -- READ BEFORE REMOVING THE playwright PIN: the mcr.microsoft.com/playwright/python image
# ships the BROWSERS ONLY, not the Python library. Its own build file (microsoft/playwright-python,
# utils/docker/Dockerfile.jammy at tag v1.48.0, read at the source) installs the wheel into a
# virtualenv at /ms-playwright-agent/venv (lines 28-35), runs `playwright install --with-deps` from
# that venv to populate /ms-playwright (line 37), then `rm -rf /ms-playwright-agent` (line 49). The
# venv, and the playwright package with it, is DELETED from the shipped image. What survives: system
# python3 (/usr/bin/python3, 3.10) + pip, the browsers under /ms-playwright, their native libs, and
# ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright (line 19). That one fact explains all three boot
# crashes on this service: no tzdata (bare python3), no chromium-1194 (the browsers are
# /ms-playwright/chromium-1140), and finally `No module named playwright` for system python3.
#
# So the library is OUR install, into the SAME python3 that runs the CMD. The version MUST equal the
# image tag: the 1.48.0 wheel's browsers.json asks for chromium revision 1140, which is exactly what
# /ms-playwright holds; any other pin makes it look for a revision the image does not carry. Do NOT
# add `playwright install` -- the browsers are already there and it would re-download ~300MB.
# tzdata: cc#2014 (the jammy image has no /usr/share/zoneinfo; tzdata is the stdlib zoneinfo
# fallback, PEP 615, and the code keeps Asia/Kolkata as the canon -- no hardcoded +05:30).
RUN pip install --no-cache-dir "psycopg[binary]" tzdata playwright==1.48.0

# Reads its config from environment variables (DATABASE_URL, VISUAL_AUDIT_BASE_URL,
# SCORR_AUTH_PASSWORD, optional VISUAL_AUDIT_POLL_SECONDS and CC_CHROMIUM -- see
# reports/CC2012_visual_audit_pixel_lens.md item 8 for the complete list); no flags needed.
# cc#2012: this is an ALWAYS-ON worker, not a Cron Job -- one browser, one login, one DB
# connection for the life of the process; it polls visual_audit_requests every 60s and runs the
# full crawl itself at 03:00 IST (decided in-process; Railway cron is UTC-only). Railway restarts
# it ON_FAILURE (railway.visualaudit.json). --once exists for a manual smoke test.
CMD ["python3", "visual_audit.py"]
